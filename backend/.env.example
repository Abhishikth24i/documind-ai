# Copy this file to .env and edit as needed.

# ---- LLM_PROVIDER chooses how answers are generated ----
# "groq"      -> FREE hosted LLM, works on a public deployment. Get a free key
#                at https://console.groq.com/keys
# "ollama"    -> free, but only works when the server itself can reach a
#                running Ollama instance — fine for local use, NOT for a
#                public website other people visit over the internet.
# "anthropic" -> paid Claude API, requires ANTHROPIC_API_KEY.
LLM_PROVIDER=ollama

# --- Only used when LLM_PROVIDER=groq (recommended for public deployment) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Only used when LLM_PROVIDER=ollama (local development) ---
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# --- Only used when LLM_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Retrieval settings (used regardless of provider) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4

# --- Public deployment safety ---
MAX_DOCS_PER_SESSION=10
